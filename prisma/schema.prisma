// Schema do Último Gole FC.
// Datas são armazenadas em UTC (timestamptz) e convertidas para America/Sao_Paulo na exibição.
// A classificação NÃO é persistida: é calculada a partir das partidas encerradas (modo AUTO).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
  FOOTBALL_MANAGER
  VIEWER
  TREASURER
}

enum FinanceEntryType {
  INCOME
  EXPENSE
}

enum FinanceCategory {
  MEMBERSHIP
  SPONSORSHIP
  DONATION
  EVENT
  OTHER_INCOME
  REFEREE
  FIELD
  UNIFORM
  EQUIPMENT
  TRANSPORT
  REGISTRATION
  PLAYER_PAYMENT
  OTHER_EXPENSE
}

enum DirectorStatus {
  ACTIVE
  AWAY
  ON_LEAVE
  INACTIVE
  DISMISSED
}

enum PaymentMethod {
  PIX
  CASH
  TRANSFER
  CARD
  OTHER
}

enum FinanceSource {
  MANUAL
  GATEWAY
}

enum AgreementKind {
  SPONSORSHIP
  DONATION
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum MatchEventType {
  GOAL
  PENALTY_GOAL
  OWN_GOAL
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
}

enum LineupRole {
  STARTER
  SUBSTITUTE
}

enum StandingsMode {
  AUTO
  MANUAL
}

enum Tiebreaker {
  WINS
  GOAL_DIFFERENCE
  GOALS_FOR
  GOALS_AGAINST
  HEAD_TO_HEAD
}

enum AthletePosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum AthleteStatus {
  ACTIVE
  INACTIVE
}

enum StaffGroup {
  BOARD
  TECHNICAL
}

enum GalleryCategory {
  MATCH
  EVENT
  BACKSTAGE
  FANS
  SOCIAL
}

enum SponsorTier {
  MASTER
  OFFICIAL
  SUPPORTER
  INSTITUTIONAL
}

enum AthleteCategory {
  ADULT
  BASE_U7
  BASE_U9
  BASE_U11
  BASE_U13
  BASE_U15
  BASE_U17
  BASE_U20
  VETERAN
  MASTER
  SUPER_MASTER
  SIXTY
}

enum TechnicalStaffRole {
  HEAD_COACH
  ASSISTANT_COACH
  PHYSICAL_TRAINER
  GOALKEEPER_COACH
  PHYSIOTHERAPIST
  DOCTOR
  NUTRITIONIST
  PSYCHOLOGIST
  ANALYST
  OTHER
}

model TechnicalStaff {
  id          String            @id @default(cuid())
  name        String
  nickname    String?
  role        TechnicalStaffRole
  status      AthleteStatus     @default(ACTIVE)
  categories  AthleteCategory[] @default([])
  sortOrder   Int               @default(0)
  isPublished Boolean           @default(false)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  seasons     TechnicalStaffSeason[]

  @@index([status, isPublished])
}

model TechnicalStaffSeason {
  technicalStaffId String
  seasonId         String
  assignedAt       DateTime @default(now()) @db.Timestamptz(3)

  technicalStaff TechnicalStaff @relation(fields: [technicalStaffId], references: [id], onDelete: Cascade)
  season         Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@id([technicalStaffId, seasonId])
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(VIEWER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  sessions    Session[]
  articles    NewsArticle[]
  auditLogs      AuditLog[]
  mediaAssets    MediaAsset[]
  financeEntries FinanceEntry[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  summary   String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  articles NewsArticle[]
}

model NewsArticle {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  summary        String
  content        String     @db.Text
  status         NewsStatus @default(DRAFT)
  publishedAt    DateTime?  @db.Timestamptz(3)
  authorName     String?
  coverPath      String?
  seoTitle       String?
  seoDescription String?
  categoryId     String?
  authorId       String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  category NewsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Club {
  id        String   @id @default(cuid())
  name      String   @unique
  shortName String?
  slug      String   @unique
  crestPath String?
  isOwnClub Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  seasons     CompetitionTeam[]
  homeMatches Match[]            @relation("HomeTeam")
  awayMatches Match[]            @relation("AwayTeam")
  overrides   StandingOverride[]
  matchEvents MatchEvent[]
}

model Competition {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  seasons  Season[]
  payments FinanceEntry[]
}

model Season {
  id            String        @id @default(cuid())
  competitionId String
  label         String
  regulation    String?       @db.Text
  pointsWin     Int           @default(3)
  pointsDraw    Int           @default(1)
  pointsLoss    Int           @default(0)
  tiebreakers   Tiebreaker[]  @default([WINS, GOAL_DIFFERENCE, GOALS_FOR])
  standingsMode StandingsMode @default(AUTO)
  isCurrent     Boolean       @default(false)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  competition Competition        @relation(fields: [competitionId], references: [id], onDelete: Restrict)
  teams       CompetitionTeam[]
  matches     Match[]
  overrides   StandingOverride[]
  technicalStaff TechnicalStaffSeason[]

  @@unique([competitionId, label])
}

model CompetitionTeam {
  seasonId  String
  clubId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@id([seasonId, clubId])
  @@index([clubId])
}

model Match {
  id         String      @id @default(cuid())
  seasonId   String
  homeTeamId String
  awayTeamId String
  kickoffAt  DateTime    @db.Timestamptz(3)
  venue      String?
  round      String?
  status     MatchStatus @default(SCHEDULED)
  homeScore  Int?
  awayScore  Int?
  notes      String?     @db.Text
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  season   Season              @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  homeTeam Club                @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam Club                @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  events   MatchEvent[]
  lineup   MatchLineupPlayer[]
  expenses FinanceEntry[]

  @@index([seasonId, status])
  @@index([status, kickoffAt])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

// Usado apenas quando Season.standingsMode = MANUAL.
model StandingOverride {
  id           String @id @default(cuid())
  seasonId     String
  clubId       String
  position     Int
  played       Int    @default(0)
  wins         Int    @default(0)
  draws        Int    @default(0)
  losses       Int    @default(0)
  goalsFor     Int    @default(0)
  goalsAgainst Int    @default(0)
  points       Int    @default(0)

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([seasonId, clubId])
}

model Athlete {
  id          String           @id @default(cuid())
  name        String
  nickname    String?
  position    AthletePosition
  category    AthleteCategory  @default(ADULT)
  shirtNumber Int?
  bio         String?          @db.Text
  photoPath   String?
  status      AthleteStatus    @default(ACTIVE)
  // Só aparece no portal quando a divulgação foi autorizada.
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  matchEvents MatchEvent[]
  lineups     MatchLineupPlayer[]
  payments    FinanceEntry[]

  @@index([isPublished, status, position])
  @@index([category])
}

model StaffMember {
  id          String     @id @default(cuid())
  name        String
  role        String
  group       StaffGroup
  sortOrder   Int        @default(0)
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  @@index([isPublished, group, sortOrder])
}

model Sponsor {
  id           String      @id @default(cuid())
  name         String
  tier         SponsorTier
  description  String?     @db.Text
  logoPath     String?
  websiteUrl   String?
  instagramUrl String?
  startsAt     DateTime?   @db.Timestamptz(3)
  endsAt       DateTime?   @db.Timestamptz(3)
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(false)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)

  agreements FinanceAgreement[]

  @@index([isActive, tier, sortOrder])
}

// Conteúdo institucional editável pelo painel (chave → texto). As chaves válidas ficam em modules/site/settings.ts.
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  ipAddress String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([ipAddress, createdAt])
}

// Metadados dos arquivos enviados. O binário fica no armazenamento (pasta local ou S3), nunca no banco.
model MediaAsset {
  id           String   @id @default(cuid())
  key          String   @unique
  mimeType     String
  size         Int
  originalName String?
  uploadedById String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  uploadedBy    User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  galleryImages GalleryImage[]

  @@index([createdAt])
}

model Gallery {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String?         @db.Text
  category    GalleryCategory
  eventDate   DateTime?       @db.Timestamptz(3)
  isPublished Boolean         @default(false)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  images GalleryImage[]

  @@index([isPublished, eventDate])
}

model GalleryImage {
  id        String   @id @default(cuid())
  galleryId String
  mediaId   String
  altText   String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  gallery Gallery    @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([galleryId, sortOrder])
  @@index([mediaId])
}

// Lances da partida. São informativos: o placar oficial é o registrado na própria partida.
model MatchEvent {
  id         String         @id @default(cuid())
  matchId    String
  clubId     String
  type       MatchEventType
  minute     Int?
  // Jogador do nosso elenco (opcional) ou nome digitado (adversários e atletas não cadastrados).
  athleteId  String?
  playerName String?
  note       String?
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  match   Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  club    Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  athlete Athlete? @relation(fields: [athleteId], references: [id], onDelete: SetNull)

  @@index([matchId, minute])
  @@index([athleteId])
}

// Escalação do nosso clube em uma partida.
model MatchLineupPlayer {
  matchId   String
  athleteId String
  role      LineupRole
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([matchId, athleteId])
  @@index([athleteId])
}

// ---------- Financeiro ----------
// Valores sempre em centavos (inteiros). Lançamentos nunca são apagados: um erro é corrigido por estorno
// (voidedAt), para preservar o histórico do caixa.

model FinanceEntry {
  id          String           @id @default(cuid())
  type        FinanceEntryType
  category    FinanceCategory
  description String
  amountCents Int
  occurredOn  DateTime         @db.Timestamptz(3)
  method      PaymentMethod
  // Preparado para pagamento pela plataforma: lançamentos criados por um serviço de pagamento
  // terão source = GATEWAY e o identificador da transação em externalReference (único).
  source            FinanceSource @default(MANUAL)
  externalReference String?       @unique
  notes             String?       @db.Text
  matchId           String?
  agreementId       String?
  // Folha de pagamento: jogador que recebeu e competição a que o pagamento se refere.
  athleteId         String?
  competitionId     String?
  createdById       String?
  voidedAt          DateTime?     @db.Timestamptz(3)
  voidReason        String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  match       Match?            @relation(fields: [matchId], references: [id], onDelete: SetNull)
  agreement   FinanceAgreement? @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  athlete     Athlete?          @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  competition Competition?      @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  due         MembershipDue?

  @@index([occurredOn])
  @@index([type, category])
  @@index([matchId])
  @@index([agreementId])
  @@index([athleteId])
  @@index([competitionId])
}

// Mensalidade de um diretor em um mês ("AAAA-MM"). Paga quando tem um lançamento válido ligado.
model MembershipDue {
  id             String    @id @default(cuid())
  directorId     String
  referenceMonth String
  amountCents    Int
  dueDate        DateTime  @db.Timestamptz(3)
  waivedAt       DateTime? @db.Timestamptz(3)
  waivedReason   String?
  entryId        String?   @unique
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  director Director      @relation(fields: [directorId], references: [id], onDelete: Restrict)
  entry    FinanceEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@unique([directorId, referenceMonth])
  @@index([referenceMonth])
}

// Valor combinado com um patrocinador ou doador. O recebido é a soma dos lançamentos ligados.
model FinanceAgreement {
  id          String        @id @default(cuid())
  kind        AgreementKind
  name        String
  sponsorId   String?
  agreedCents Int
  startsOn    DateTime?     @db.Timestamptz(3)
  endsOn      DateTime?     @db.Timestamptz(3)
  notes       String?       @db.Text
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  sponsor Sponsor?       @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  entries FinanceEntry[]

  @@index([isActive, kind])
}

// Cadastro de diretores (painel administrativo). São eles que pagam a mensalidade do clube.
model Director {
  id        String         @id @default(cuid())
  name      String
  role      String
  status    DirectorStatus @default(ACTIVE)
  photoPath String?
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  dues MembershipDue[]

  @@index([status, name])
}
