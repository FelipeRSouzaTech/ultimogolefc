# Copie para .env e ajuste. Nunca versione o arquivo .env.

# Banco de dados (os valores abaixo são apenas para desenvolvimento local com Docker Compose)
# A senha deve ser IGUAL em POSTGRES_PASSWORD e em DATABASE_URL. Use só letras e números.
# Coloque a senha real apenas no arquivo .env, nunca neste arquivo.
POSTGRES_USER=ultimogole
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=ultimogole
DATABASE_URL=postgresql://ultimogole:troque-esta-senha-local@localhost:5432/ultimogole?schema=public

# URL pública do portal (usada em metadados e links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Duração da sessão administrativa, em dias
SESSION_TTL_DAYS=7

# Armazenamento de imagens enviadas pelo painel: "local" (pasta no servidor) ou "s3" (compatível com S3)
STORAGE_DRIVER=local
# Pasta usada pelo driver local (precisa ser persistente e entrar no backup)
STORAGE_LOCAL_DIR=./storage/uploads

# Somente para STORAGE_DRIVER=s3 (AWS S3, Cloudflare R2, MinIO etc.)
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=ultimogole
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Endereço público de leitura do bucket (domínio próprio ou CDN), sem barra no final
# S3_PUBLIC_URL=https://midia.seudominio.com.br

# Banco EXCLUSIVO para "npm run test:integration" (nunca o de desenvolvimento ou produção)
# TEST_DATABASE_URL=postgresql://ultimogole:troque-esta-senha-local@localhost:5432/ultimogole_test?schema=public

# Instagram (publicação no feed e nos stories). Passo a passo em docs/INSTAGRAM.md.
# Sem INSTAGRAM_USER_ID e INSTAGRAM_ACCESS_TOKEN, o painel só cria rascunhos e agendamentos (nada é publicado).
# Para trocar a conta de teste pela do clube, troque estes valores; o código não muda.
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# Nome da conta mostrado no painel e gravado em cada publicação (ex.: @minha.conta.teste)
# INSTAGRAM_ACCOUNT_LABEL=
# graph.instagram.com (login do Instagram, não exige Página do Facebook) ou graph.facebook.com (login do Facebook)
# INSTAGRAM_API_HOST=graph.instagram.com
# INSTAGRAM_API_VERSION=v25.0

# Segredo do agendador: o serviço que chama /api/cron/instagram envia "Authorization: Bearer <CRON_SECRET>".
# Use pelo menos 32 caracteres aleatórios (ex.: openssl rand -hex 32).
# CRON_SECRET=
# Agendador: "interno" (o próprio servidor confere a fila a cada minuto; padrão fora da Vercel) ou "externo" (cron-job.org etc.)
# INSTAGRAM_SCHEDULER=interno
